# ai-server/.env 예시 (실제 값은 .env 에만 넣는다. Git에 올리지 않는다)
# 이 파일이 없거나 값이 비어 있으면 ../backend/.env 의 같은 이름 값을 쓴다.
# → 키는 backend/.env 한 곳에만 넣어도 된다.

# OpenAI (platform.openai.com > API keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# 답변 전 추론 정도 (none/low/medium/high). 비우면 모델 기본값
OPENAI_REASONING_EFFORT=low

# 우리 Spring 서버 (Tool 이 시세·실적·뉴스를 조회하는 곳)
SPRING_BASE_URL=http://localhost:8085
# Spring 의 AI_INTERNAL_KEY 와 같은 값 (비우면 검사 안 함, 로컬 개발용)
AI_INTERNAL_KEY=

# Tool 하나당 제한 시간(초) - 팀 결정 5초
TOOL_TIMEOUT_SECONDS=5
