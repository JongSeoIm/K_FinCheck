AI_MODE=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
SPRING_BASE_URL=http://127.0.0.1:8080
# 질문 해석만 더 싼 모델로 돌릴 때 (비우면 OPENAI_MODEL 사용). 예: gpt-5.4-nano
OPENAI_INTERPRET_MODEL=
# 사업보고서 RAG 임베딩. false 면 글자 비교로 대신한다(추가 비용 없음).
RAG_EMBEDDING_ENABLED=true
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 사업보고서 RAG 저장소: mariadb(기본, Spring API 경유로 MariaDB 에 저장·검색) 또는 sqlite(예전 파일 방식)
REPORT_STORE=mariadb
