# backend/.env 예시 (이 파일은 Git에 올려도 되는 견본, 실제 값은 .env 에만 넣는다)
# 형식: 이름=값  (따옴표·공백 없이)

# ----- 시세 제공처: 한국투자증권 KIS Open API -----
# kis: KIS 실제 시세 (키가 없으면 서버가 시작되지 않음) / demo: 모의 데이터
MARKET_PROVIDER=kis
# KIS Developers > 신청현황의 APP Key / APP Secret 복사 버튼으로 붙여 넣는다 (실전투자계좌 키)
KIS_APP_KEY=
KIS_APP_SECRET=

# ----- 종목 뉴스: NAVER API HUB 검색 API (뉴스) -----
# 네이버 클라우드 플랫폼 콘솔 > Services > Application Services > NAVER API HUB > Application 등록 (검색 API 선택)
# Application 선택 > API 관리 > [인증 정보] 의 Client ID / Client Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ----- DB (기본: MariaDB) -----
DB_USERNAME=root
DB_PASSWORD=
# MariaDB 포트가 3306이 아니면(예: 3300) 아래 줄의 # 을 지우고 포트를 바꾼다
#DB_URL=jdbc:mariadb://localhost:3300/stockdb?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true

# MariaDB 없이 실행하려면 아래 두 줄의 # 을 지운다 (서버를 끄면 데이터 초기화)
#DB_DRIVER=org.h2.Driver
#DB_URL=jdbc:h2:mem:stockdb;MODE=MariaDB;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1
