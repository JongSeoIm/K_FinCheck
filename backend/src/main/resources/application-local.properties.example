# 이 파일을 application-local.properties 로 복사해서 값을 채우세요.
# application-local.properties 는 git 에 올리지 않습니다. (실제 키·비밀번호 금지)

# 한국투자증권(KIS) Open API
kis.app-key=
kis.app-secret=

# NAVER API HUB 뉴스 검색
naver-news.client-id=
naver-news.client-secret=

# OpenDART
dart.api-key=

# MariaDB (DB 이름 kfincheck)
spring.datasource.url=jdbc:mariadb://127.0.0.1:3306/kfincheck
spring.datasource.username=
spring.datasource.password=
spring.datasource.hikari.connection-timeout=3000

# AI 서버(Python)를 기본값(127.0.0.1:8000)과 다르게 쓸 때만 추가
# ai.server-url=http://127.0.0.1:8000
# ai.timeout-seconds=60
